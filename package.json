{
  "name": "lumi-monsters",
  "private": true,
  "version": "0.1.0",
  "description": "루미 몬스터즈: 별빛의 씨앗 — 몬스터 수집·배틀 RPG에 농사·채집·제작을 더한 2D 픽셀 멀티플레이 웹 게임 (Vite + TypeScript + Phaser 3)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:art": "node tools/art/generate.mjs",
    "gen:map": "node tools/map/generate-map.mjs",
    "gen": "npm run gen:art && npm run gen:map",
    "server": "tsx server/index.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "ws": "^8.18.2"
  }
}
