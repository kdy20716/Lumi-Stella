# 이 파일을 복사해서 .env 로 만들고 값을 채우세요. (.env 는 깃허브에 올라가지 않아요)

# ── 프론트엔드 (Vite) ─────────────────────────────
# 게임 서버(Socket.io) 주소. Vercel 에서는 프로젝트 › Settings › Environment Variables 에 같은 이름으로 넣고 다시 배포
#   예) VITE_SERVER_URL=https://lumi-server.azurewebsites.net
# 비워 두면 로컬 개발용으로 같은 PC 의 2567 포트에 접속
VITE_SERVER_URL=

# ── 백엔드 (Azure App Service › 구성 › 애플리케이션 설정) ──
# 접속을 허용할 프론트엔드 주소 (쉼표로 여러 개). 비우면 모두 허용(개발용)
#   예) CLIENT_ORIGIN=https://lumi-monsters.vercel.app,http://localhost:5173
CLIENT_ORIGIN=
# PORT 는 Azure 가 자동으로 넣어 줌 (로컬 기본 2567)

# ── 일러스트 생성 도구 (내 PC 에서만, npm run gen:illust) ──
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=
# 선택: 그림 모델 (기본 gemini-3.1-flash-image)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
