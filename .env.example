# 이 파일을 복사해서 .env 로 만들고 값을 채우세요. (.env 는 깃허브에 올라가지 않아요)

# ── 프론트엔드 (Vite) ─────────────────────────────
# 게임 서버(Socket.io) 주소. Vercel 에서는 프로젝트 › Settings › Environment Variables 에 같은 이름으로 넣고 다시 배포
#   예) VITE_SERVER_URL=https://lumi-server.azurewebsites.net
# 비워 두면 로컬 개발용으로 같은 PC 의 2567 포트에 접속
VITE_SERVER_URL=

# ── 백엔드 (Azure App Service › 구성 › 애플리케이션 설정) ──
# 접속을 허용할 프론트엔드 주소 (쉼표로 여러 개). 비우면 모두 허용(개발용)
#   예) CLIENT_ORIGIN=https://lumistella.vercel.app,http://localhost:5173
CLIENT_ORIGIN=
# PORT 는 Azure 가 자동으로 넣어 줌 (로컬 기본 2567)

# ── 일러스트 생성 도구 (내 PC 에서만, npm run gen:illust) ──
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=
# 선택: 그림 모델 (기본 gemini-3.1-flash-image)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ── PayPal 캐쉬 상점 실결제 · 결제 링크 연동 (백엔드 서버용) ──
# 방식 1 (추천 — 결제 완료 시 자동으로 게임 캐쉬 지급): PayPal Developer Dashboard > Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (테스트 결제, 기본값) 또는 live (실제 결제)
PAYPAL_ENV=sandbox
# USD (모든 PayPal 계정 호환, 기본값) 또는 KRW
PAYPAL_CURRENCY=USD

# 방식 2 (선택 — PayPal.me 또는 PayPal 결제 링크 직접 연결)
# PAYPAL_ME_URL=https://www.paypal.me/내아이디
# PAYPAL_LINK_CASH_1500=
# PAYPAL_LINK_CASH_5000=
# PAYPAL_LINK_CASH_10000=
# PAYPAL_LINK_CASH_30000=
# PAYPAL_LINK_CASH_50000=
# PAYPAL_LINK_CASH_100000=
